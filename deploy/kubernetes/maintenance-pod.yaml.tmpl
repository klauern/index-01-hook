apiVersion: v1
kind: Pod
metadata:
  name: index-01-hook-maintenance
  namespace: index-01-hook
  labels:
    app.kubernetes.io/name: index-01-hook-maintenance
spec:
  IMAGE_PULL_SECRETS_PLACEHOLDER
  serviceAccountName: index-01-hook
  automountServiceAccountToken: false
  enableServiceLinks: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 65532
    runAsGroup: 65532
    fsGroup: 65532
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile:
      type: RuntimeDefault
  containers:
    - name: maintenance
      image: IMAGE_REF_PLACEHOLDER
      imagePullPolicy: IfNotPresent
      command:
        - /index-01-hook
        - maintenance
      env:
        - name: INDEX01_DB_PATH
          value: /var/lib/index-01-hook/data/index01.db
      securityContext:
        privileged: false
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop:
            - ALL
      resources:
        requests:
          cpu: 10m
          memory: 32Mi
        limits:
          cpu: 100m
          memory: 128Mi
      volumeMounts:
        - name: data
          mountPath: /var/lib/index-01-hook
  volumes:
    - name: data
      persistentVolumeClaim:
        claimName: index-01-hook-data
