apiVersion: apps/v1
kind: Deployment
metadata:
  name: index-01-hook
  namespace: index-01-hook
  labels:
    app.kubernetes.io/name: index-01-hook
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: index-01-hook
  template:
    metadata:
      labels:
        app.kubernetes.io/name: index-01-hook
        app.kubernetes.io/part-of: index-01
    spec:
      IMAGE_PULL_SECRETS_PLACEHOLDER
      serviceAccountName: index-01-hook
      automountServiceAccountToken: false
      enableServiceLinks: false
      terminationGracePeriodSeconds: 30
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: index-01-hook
          image: IMAGE_REF_PLACEHOLDER
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          ports:
            - name: http
              containerPort: 8080
          envFrom:
            - secretRef:
                name: index-01-hook-secrets
                optional: false
          env:
            - name: INDEX01_DB_PATH
              value: /var/lib/index-01-hook/data/index01.db
            - name: INDEX01_LISTEN_ADDR
              value: :8080
            - name: INDEX01_MAX_BODY_BYTES
              value: "67108864"
            - name: INDEX01_WORKER_OWNER
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
          volumeMounts:
            - name: data
              mountPath: /var/lib/index-01-hook
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 30
            periodSeconds: 2
            timeoutSeconds: 2
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 10
            timeoutSeconds: 2
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /healthz
              port: http
            periodSeconds: 20
            timeoutSeconds: 2
            failureThreshold: 3
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: index-01-hook-data
