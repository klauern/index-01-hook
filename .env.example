# Copy this file to .env, replace each required value, and run: chmod 0600 .env
# Docker Compose reads INDEX01_IMAGE and INDEX01_HOST_PORT only for deployment.
INDEX01_IMAGE=index-01-hook:local
INDEX01_HOST_PORT=8080

# Required application settings.
# Generate a cryptographically random Bearer token of at least 32 bytes.
# Bearer token for webhook requests.
INDEX01_WEBHOOK_TOKEN=
# DeepSeek API bearer token.
INDEX01_DEEPSEEK_TOKEN=
# TickTick Open API bearer token.
INDEX01_TICKTICK_TOKEN=
# Writable TickTick task project identifier, or inbox.
INDEX01_TICKTICK_DEFAULT_PROJECT_ID=
# Writable TickTick note project identifier.
INDEX01_TICKTICK_NOTE_PROJECT_ID=

# Optional application settings.
INDEX01_DEEPSEEK_MODEL=deepseek-v4-flash
INDEX01_TIME_ZONE=UTC
INDEX01_TICKTICK_PROJECT_ALIASES={}
INDEX01_MAX_BODY_BYTES=67108864
INDEX01_WORKER_OWNER=index-01-hook
